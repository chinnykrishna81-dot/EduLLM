FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/content-management/package.json apps/content-management/package.json
COPY apps/unified-learning/package.json apps/unified-learning/package.json
COPY packages/content-schema/package.json packages/content-schema/package.json
RUN npm ci

COPY apps/content-management apps/content-management
COPY apps/unified-learning apps/unified-learning
COPY apps/competency-patterns.css apps/competency-patterns.css
COPY packages/content-schema packages/content-schema
RUN npm run build -w @edullm/content-schema && \
    VITE_API_ORIGIN='' VITE_BASE_PATH='/admin/' npm run build -w @edullm/content-management && \
    VITE_API_BASE='/api' VITE_API_ORIGIN='' npm run build -w @edullm/unified-learning

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/unified-learning/dist /usr/share/nginx/html
COPY --from=build /app/apps/content-management/dist /usr/share/nginx/html/admin
EXPOSE 80

