{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::edullm-media-994516184686-ap-south-1",
      "Condition": { "StringLike": { "s3:prefix": ["edullm/*"] } }
    },
    {
      "Sid": "ManageEduLLMMedia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:GetObjectAttributes"],
      "Resource": "arn:aws:s3:::edullm-media-994516184686-ap-south-1/edullm/*"
    }
  ]
}
